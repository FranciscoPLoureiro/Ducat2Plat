{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["*.ts", "../shared/*.ts"],
  "exclude": ["../shared/*.test.ts"]
}
